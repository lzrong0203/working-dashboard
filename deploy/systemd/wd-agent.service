# ~/.config/systemd/user/wd-agent.service  (see wd-hub.service for the rationale)
[Unit]
Description=working-dashboard agent (collects Claude Code sessions, pushes over ssh)
After=network-online.target

[Service]
ExecStart=%h/.local/bin/wd agent
Restart=always
RestartSec=15
CPUSchedulingPolicy=idle
Nice=19
IOSchedulingClass=idle
LimitAS=1G
CPUQuota=5%
MemoryMax=128M
NoNewPrivileges=yes

[Install]
WantedBy=default.target
