# ~/.config/systemd/user/wd-hub.service
# The hub must never compete with other services on a shared server.
#  * CPUSchedulingPolicy=idle: SCHED_IDLE, runs only on otherwise-idle CPU time.
#    A per-process attribute, so it works even where cgroups aren't delegated
#    to user services (e.g. cgroup v1/hybrid hosts, where CPUQuota/MemoryMax
#    below are silently ignored).
#  * LimitAS: hard address-space cap enforced by the kernel via rlimit.
# Run `loginctl enable-linger $USER` once so it survives logout and reboots.
[Unit]
Description=working-dashboard hub (127.0.0.1 only)
After=network-online.target

[Service]
ExecStart=%h/.local/bin/wd serve
Restart=on-failure
RestartSec=10
CPUSchedulingPolicy=idle
Nice=19
IOSchedulingClass=idle
LimitAS=2G
CPUQuota=10%
MemoryMax=256M
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
